NODE_ENV=development
PORT=4000
STORAGE_MODE=memory
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=http://localhost:5173

# Hours until a login session expires (default 8)
SESSION_TTL_HOURS=8

# lax works when frontend and API share a site (local dev, or one domain).
# "none" is only for a frontend and API on different sites in production.
COOKIE_SAMESITE=lax

# Set to true when hosted behind a proxy such as Render
TRUST_PROXY=false

# First administrator, created at startup only if no admin exists yet.
# Set all three or none. Use a strong password and never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Restaurant data import (OpenStreetMap through the Overpass API) ----
# Real restaurants are imported from OpenStreetMap, which needs no API key. Data is under the
# ODbL licence: keep the "(c) OpenStreetMap contributors" credit visible in the app.
RESTAURANT_API_PROVIDER=osm
RESTAURANT_API_URL=https://overpass-api.de/api/interpreter
# Optional second server to try when the first is busy
RESTAURANT_API_FALLBACK_URL=
# Only for providers that need a key. OpenStreetMap does not. Server-side only: never put it in the frontend.
RESTAURANT_API_KEY=
# Who is calling the API. Overpass asks for a real contact so they can reach you.
RESTAURANT_API_USER_AGENT=RestaurantReservationSystem/1.0 (your-name; your-email@example.com)
# Which kinds of places to import
IMPORT_AMENITIES=restaurant,cafe,bar,pub
# Time zone used to show reservation dates and times
APP_TIMEZONE=Asia/Manila
